<Window x:Class="OpenLauncher.UI.UserAgreementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户协议"
        Width="660" Height="740"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="22,16" Background="{DynamicResource Card}">
            <TextBlock Text="用户协议" Style="{DynamicResource H1}"/>
        </Border>

        <RichTextBox x:Name="Doc"
                     Grid.Row="1"
                     IsReadOnly="True"
                     IsDocumentEnabled="False"
                     Margin="22,14"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     FontSize="13"
                     Padding="2"/>

        <Border Grid.Row="2" Padding="18,12" Background="{DynamicResource Card}">
            <Grid>
                <TextBlock x:Name="Hint"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{DynamicResource Sub}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ExitBtn"
                            Content="退出"
                            Width="92" Margin="0,0,10,0"
                            Style="{DynamicResource BaseButton}"
                            IsEnabled="False"
                            Click="ExitBtn_Click"/>
                    <Button x:Name="AgreeBtn"
                            Content="同意并继续"
                            Width="128"
                            Style="{DynamicResource Primary}"
                            IsDefault="True"
                            IsEnabled="False"
                            Click="AgreeBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
